{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run db:push && next build",
  "crons": [
    {
      "path": "/api/sync/gamma",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/sync/tags",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/sync/gamma-comments",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/sync/users",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/sync/resolution",
      "schedule": "15,45 * * * *"
    },
    {
      "path": "/api/sync/translations",
      "schedule": "0 */6 * * *"
    }
  ],
  "ignoreCommand": "exit 1",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "polymarket-v2": true,
      "*": false
    }
  }
}

# ============================================================
# REQUIRED
# ============================================================

# Polymarket CLOB L2 user auth, derived from the operator wallet at
# https://polymarket.com/settings (or via POST /auth/api-key).
POLY_ADDRESS=""
POLY_API_KEY=""
POLY_API_SECRET=""
POLY_PASSPHRASE=""

# Polymarket builder credentials, from polymarket.com/settings?tab=builder.
# Server-only. Used by the V2 relayer for SAFE-CREATE and SAFE Safe-tx submission.
POLYMARKET_BUILDER_API_KEY=""
POLYMARKET_BUILDER_SECRET=""
POLYMARKET_BUILDER_PASSPHRASE=""
# bytes32 builder code, signed into every order's `builder` field for attribution.
# `POLY_BUILDER_CODE` is also accepted for compatibility with Polymarket docs/SDK examples.
POLYMARKET_BUILDER_CODE=""

# Admin wallets (comma-separated, EVM 0x... addresses on Polygon)
ADMIN_WALLETS=""

# Browser-visible Reown AppKit project id from https://dashboard.reown.com/
# Required by Reown's client-side AppKit/Wagmi adapter.
NEXT_PUBLIC_REOWN_APPKIT_PROJECT_ID=""
# Legacy fallback accepted by older server-side code paths; prefer the public key above.
REOWN_APPKIT_PROJECT_ID=""

# Random 32 characters – generate one on "generate secret" button https://www.better-auth.com/docs/installation#set-environment-variables
# Changing this value will invalidate all user sessions AND encrypted credentials, requiring users to log in and re-authenticate for trading.
BETTER_AUTH_SECRET=""

# Vercel Cron Jobs (Create a random secret of at least 16 characters)
CRON_SECRET=""

# ============================================================
# POLYMARKET INTEGRATION ENDPOINTS
# ============================================================
# All default to Polymarket production when unset (next.config.ts).
# Set these only to override (e.g. staging, regional mirror).
GAMMA_URL=""
CLOB_URL=""
DATA_URL=""
RELAYER_URL=""
WS_CLOB_URL=""
WS_LIVE_DATA_URL=""

# ============================================================
# OPTIONAL
# ============================================================

# Disable Next.js image optimization
DISABLE_IMAGE_OPTIMIZATION=false

# PostgreSQL runtime connection (required outside Vercel/Supabase integration flow)
POSTGRES_URL=""

# Supabase credentials (optional outside Supabase mode; if one is set, both are required)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# S3-compatible storage (required when SUPABASE_* is not configured)
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE=true

# Sentry monitoring https://sentry.io/
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# LI.FI SDK/API integration. Defaults are safe for development, but production
# should set these for attribution/rate limits. Integrator max length is 23.
LIFI_INTEGRATOR=""
LIFI_API_KEY=""

# Server-side Polygon RPC for balance/allowance preflights. Use an authenticated
# provider in production to avoid public RPC rate limits.
POLYGON_RPC_URL=""

# Private keys used to sign recurring event creations
# Format: comma-separated list of private keys no spaces (eg. key1,key2,key3)
EVENT_CREATION_SIGNER_PRIVATE_KEYS=
